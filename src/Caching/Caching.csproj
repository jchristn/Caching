<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Caching</PackageId>
		<Version>5.1.0</Version>
		<Authors>Joel Christner</Authors>
		<Description>Caching library including a FIFO and LRU cache, async operations, events, expiration, data persistence, and built-in OpenTelemetry-compatible metrics and traces</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/caching</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jchristn/caching</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageLicenseUrl></PackageLicenseUrl>
		<PackageReleaseNotes>Adds built-in observability: a System.Diagnostics.Metrics Meter and ActivitySource named "Caching" covering operations, hits and misses, evictions, expirations, persistence driver calls, lock waits, and cache size. See TELEMETRY.md.</PackageReleaseNotes>
		<PackageTags>fifo lru cache caching least recently used first in first out simple telemetry metrics tracing opentelemetry</PackageTags>
		<PackageIconUrl></PackageIconUrl>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>Caching.xml</DocumentationFile>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<Title>Caching</Title>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
		<!-- C# 9 is required to set InstrumentAdvice init-only properties on the down-level targets. -->
		<LangVersion>9.0</LangVersion>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<!-- Meter, ActivitySource, and InstrumentAdvice (histogram buckets) for targets whose BCL predates them. Not an exporter or SDK. -->
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="assets\icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="LICENSE.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="assets\icon.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="assets\icon.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Caching.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
